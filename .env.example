# Neon connection string: Neon console > project "kaam" > Connect > copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional: turns on the AI features (CV gap analysis, AI Manager chat, Improve with AI)
ANTHROPIC_API_KEY=
# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
